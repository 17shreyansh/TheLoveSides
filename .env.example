# ============================================
# TheLoveSides — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets.
# ============================================

# ---------- General ----------
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
STOREFRONT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ---------- MongoDB ----------
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme
MONGO_URI=mongodb://admin:changeme@localhost:27017/thelovesides?authSource=admin

# ---------- Redis ----------
REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@localhost:6379

# ---------- JWT ----------
JWT_ACCESS_SECRET=your-access-token-secret-min-32-chars-long
JWT_REFRESH_SECRET=your-refresh-token-secret-min-32-chars-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---------- Razorpay ----------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ---------- Shiprocket ----------
SHIPROCKET_EMAIL=your-shiprocket-email
SHIPROCKET_PASSWORD=your-shiprocket-password
SHIPROCKET_API_URL=https://apiv2.shiprocket.in/v1/external

# ---------- Email (SMTP) ----------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@thelovesides.com

# ---------- Storage ----------
# For local dev, files are stored on disk. In production, use S3/GCS.
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ---------- Admin Bootstrap ----------
# Used by `npm run create-admin` script
ADMIN_EMAIL=admin@thelovesides.com
ADMIN_PASSWORD=change-this-immediately

# ---------- Rate Limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# ---------- Logging ----------
LOG_LEVEL=debug
